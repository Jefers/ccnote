{
  "name": "CNotes Client Cards",
  "short_name": "CNotes",
  "description": "A local-first client notes dashboard for fitness coaches.",
  "id": "/ccnote/",
  "start_url": "/ccnote/",
  "scope": "/ccnote/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f6f1e8",
