  "icons": [
    { "src": "/ccnote/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/ccnote/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/ccnote/icons/icon-192-maskable.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/ccnote/icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
